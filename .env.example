# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key
MODEL_NAME=gemini-2.5-flash
# Seconds to wait between eval cases (helps stay under free-tier rate limits)
EVAL_DELAY=4
# Optional: tracing with Langfuse (free cloud tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
